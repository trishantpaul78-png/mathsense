# Copy this file to .env and fill in your key.
# Free key: https://console.groq.com/keys  (no credit card required)
GROQ_API_KEY=

# Optional overrides
GROQ_MODEL=openai/gpt-oss-120b
# Tried automatically if the primary model is not enabled on your account
GROQ_MODEL_FALLBACKS=openai/gpt-oss-20b,qwen/qwen3.8-27b
GROQ_REASONING_EFFORT=low
GROQ_TIMEOUT_SECONDS=25
GROQ_MAX_TOKENS=1200
